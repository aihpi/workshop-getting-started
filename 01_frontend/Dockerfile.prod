# Production image: build static assets with Vite, serve with nginx.
FROM node:20-alpine AS build

WORKDIR /app

# VITE_BACKEND_URL is baked in at build time. Override with --build-arg if needed.
ARG VITE_BACKEND_URL=http://localhost:8000
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
