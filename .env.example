# Host interface for published container ports. Default (127.0.0.1) keeps the
# stack reachable only from this machine. Supported values: 127.0.0.1 or
# 0.0.0.0 (run.sh polls localhost, so a specific interface address is not
# supported).
#
# Security note: with 0.0.0.0 the Ollama API, the backend (/chat, /health,
# /models) and the frontend are published on every network interface without
# authentication. Use it only on a trusted LAN, never on public or shared wifi.
#BIND_HOST=0.0.0.0

# URL the browser uses to reach the backend. When exposing the stack on a LAN
# (BIND_HOST=0.0.0.0), set it to the address of the machine running Compose,
# otherwise remote browsers resolve "localhost" to their own device.
#VITE_BACKEND_URL=http://192.168.1.10:8000

# Folder with Ollama models, mounted into the chatbot's Ollama container so a
# model pulled with a native Ollama is not downloaded twice. run.sh picks
# /usr/share/ollama/.ollama/models (Linux/WSL service) or ~/.ollama/models.
# Set it when Docker Desktop cannot share the detected path.
#OLLAMA_MODELS=/home/you/.ollama/models
